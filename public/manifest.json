{
  "manifest_version": 3,
  "name": "本機直播翻譯 · Live Local",
  "description": "無字幕直播：本地 Whisper 語音辨識、離線模型翻譯與專有名詞詞彙卡。",
  "version": "0.4.3",
  "version_name": "0.4.3-preview",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "tabCapture",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*",
    "http://127.0.0.1/*",
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self';"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}